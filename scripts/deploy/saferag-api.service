[Unit]
Description=SafeRAG Backend API
After=network-online.target saferag-qwen4b.service saferag-qwen2b.service
Wants=network-online.target
Wants=saferag-qwen4b.service saferag-qwen2b.service

[Service]
Type=simple
WorkingDirectory=/data/saferag/app
EnvironmentFile=/etc/saferag/api.env
ExecStart=/usr/local/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8081

Restart=on-failure
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target